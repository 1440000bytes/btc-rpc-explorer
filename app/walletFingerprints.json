		"batching": ["multi", "single"],
		"bip69": ["always", "never"],
		"address_reuse": ["yes", "no"],
		"change_position": ["last", "any"],
		"change_type": ["input", "payment"],
		"nsequence": "list of exact nSequence hex values the wallet uses; omit the field when not known (treated as any)"
